// SendYurt data model.
// Runs on PostgreSQL (Vercel Postgres / Neon / Supabase). The schema avoids
// Postgres-only constructs so it stays portable. Enums are modeled as strings
// constrained by zod at the app boundary (see src/lib/validators.ts) — a
// carry-over from the original SQLite setup, kept for that validation layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Investor / pilot inquiries submitted from the public pitch page.
model InvestorInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  // "INVESTOR" | "PILOT" — which CTA the inquiry came from
  kind         String   @default("INVESTOR")
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  // Household-level settings surfaced on the Household Settings page.
  currency          String  @default("UZS")
  privacyMode       Boolean @default(false)
  trustScoreSharing Boolean @default(true)

  users        User[]
  transactions Transaction[]
  budgets      Budget[]
  savingsGoals SavingsGoal[]
  trustScores  TrustScoreSnapshot[]
  trustOverrides TrustScoreOverride[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  // "SENDER" | "RECEIVER" — validated in app code (SQLite has no enums)
  role         String
  name         String
  // Profile picture as a small downscaled data URL (no external storage).
  image        String?
  languagePref String   @default("uz")
  householdId  String
  // Permission inside the household: "ADMIN" (edit budgets/goals, manage
  // roles) | "VIEWER" (read-only). Distinct from `role`, which is the
  // family position (sender/receiver). Everyone defaults to ADMIN;
  // admins may restrict others to VIEWER.
  accessRole   String    @default("ADMIN")
  // Saved "usual" transfer for one-tap rate comparisons. Minor units of
  // `usualSendCurrency` (see src/lib/money.ts).
  usualSendAmount   BigInt?
  usualSendCurrency String?
  // Set when the user finishes (or skips) the first-run walkthrough.
  onboardedAt  DateTime?
  // Platform-level access for the admin panel — distinct from `role` (family
  // position) and `accessRole` (household permission). Defaults to USER;
  // promoted to ADMIN only through an audited, admin-guarded server action.
  adminRole    AdminRole @default(USER)
  // Admins can suspend an account (blocks sign-in); an audited toggle.
  suspended    Boolean   @default(false)
  createdAt    DateTime @default(now())

  household        Household     @relation(fields: [householdId], references: [id])
  sentTransactions Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")
  passwordResetTokens PasswordResetToken[]
  notifications    Notification[]
  auditLogs        AuditLog[]    @relation("AdminAuditLogs")
  transactionEvents TransactionEvent[] @relation("TransactionEventActor")
  trustOverridesMade    TrustScoreOverride[] @relation("TrustOverrideActor")
  trustOverridesRevoked TrustScoreOverride[] @relation("TrustOverrideRevoker")
  impersonationsMade ImpersonationSession[] @relation("ImpersonationOperator")
  impersonatedAs     ImpersonationSession[] @relation("ImpersonationTarget")
  cards            Card[]
}

// A payment card linked as a funding source for transfers.
//
// PCI-DSS: we deliberately store ONLY the last four digits (a masked, non-
// sensitive value) plus the holder name and expiry — never the full PAN and
// never the CVC. `balance` is a demo stored-value amount; the transfer flow
// debits it and the `Card_balance_nonneg` CHECK keeps it from going negative
// (defined in prisma/migrations/*_money_minor_units/migration.sql).
model Card {
  id         String   @id @default(cuid())
  userId     String
  // Detected network: "visa" | "mc" | "humo" | "uzcard" | "card"
  brand      String   @default("card")
  // Last four digits only — the rest of the number is never stored.
  last4      String
  holderName String
  // "MM/YY"
  expiry     String
  // Stored-value balance in MINOR units of `currency` (tiyin for UZS).
  // Debited on transfer; never negative (Card_balance_nonneg CHECK).
  balance    BigInt   @default(0)
  currency   String   @default("UZS")
  isDefault  Boolean  @default(false)
  // Stripe linkage — set when the card is tokenized/saved via Stripe Elements.
  // The full card lives at Stripe; we keep only these references + the masked
  // details above. A card with a paymentMethodId is charged on send.
  stripeCustomerId      String?
  stripePaymentMethodId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Platform staff tier. A real Postgres enum (the app moved off SQLite),
// giving the admin layer compile-time type safety end to end.
//
// These are BUNDLES of permissions, not a linear rank — the permissions each
// one carries are defined in src/lib/permissions.ts, which is the single
// source of truth for every authorization decision.
//
//   USER        — not staff; no panel access at all
//   SUPPORT     — help customers: masked PII, read transactions, work tickets.
//                 Cannot move money, export in bulk, suspend, or see settings.
//   ADMIN       — operations: reversals, exports, suspensions, unmasked PII.
//   SUPER_ADMIN — additionally system settings and staff role management.
enum AdminRole {
  USER
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

// Append-only audit trail for privileged admin actions: who did what, to
// whom, and when. Written inside the same transaction as the mutation so the
// record and the change commit or roll back together.
model AuditLog {
  id           String   @id @default(cuid())
  // See the AuditAction union in src/lib/audit.ts.
  action       String
  // The staff member who performed the action.
  adminId      String
  // Their tier AT THE TIME of the action. Captured rather than joined,
  // because a later promotion or demotion must not rewrite history — "who
  // was allowed to do this, when" is the question an auditor asks.
  role         String?
  // The record acted upon (nullable for non-entity actions like exports).
  targetUserId String?
  targetType   String?  // "User" | "Transaction" | ...
  // Typed snapshots of the change. Separate columns rather than buried in
  // `metadata` so the viewer can render a diff without guessing at shape.
  before       Json?
  after        Json?
  // Request origin, best-effort from the proxy headers.
  ip           String?
  // Remaining context: reason codes, filters, row counts.
  metadata     Json?
  createdAt    DateTime @default(now())

  admin User @relation("AdminAuditLogs", fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([targetUserId])
  // The viewer filters by action type over a date range.
  @@index([action, createdAt])
}

/// A time-boxed, audited "view as user" session.
///
/// The browser cookie carries ONLY this row's id. Every request re-validates
/// it here, and — critically — checks that the CURRENTLY AUTHENTICATED
/// operator matches `operatorId`. That is what makes the cookie useless on its
/// own: it is a pointer to a server-side grant, not a credential. No auth
/// token is ever minted for the target user.
///
/// Rows are never deleted. `endedAt` closes a session, so the history of who
/// looked at whose account, when and why, is permanent.
model ImpersonationSession {
  id           String    @id @default(cuid())
  /// The staff member doing the viewing.
  operatorId   String
  /// The customer whose screens are being rendered.
  targetUserId String
  /// Mandatory justification, captured at start.
  reason       String
  /// Hard stop. A session is invalid past this instant even if never ended.
  expiresAt    DateTime
  /// Set when the operator exits, or when a new session supersedes this one.
  endedAt      DateTime?
  ip           String?
  startedAt    DateTime  @default(now())

  operator User @relation("ImpersonationOperator", fields: [operatorId], references: [id], onDelete: Cascade)
  target   User @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([operatorId, startedAt])
  @@index([targetUserId, startedAt])
}

model Notification {
  id          String    @id @default(cuid())
  // Fanned out per member so each person has their own read state.
  userId      String
  householdId String
  // "REMITTANCE_LOGGED" | "GOAL_NEAR" | "SCORE_CHANGE"
  type        String
  // JSON with the values needed to render the message in any language,
  // e.g. {"goal":"Toʻy fund","percent":85} — text is localized at render.
  payload     String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  // sha256 of the raw token — the raw value only ever lives in the email link
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RemittanceProvider {
  id                 String  @id @default(cuid())
  name               String
  slug               String  @unique
  // Flat fee in MINOR units of the source currency (money → BigInt).
  // KNOWN LIMITATION: one flat fee is applied to every currency in
  // `sourceCurrencies`, so 4.00 USD and 4.00 RUB are treated as equal. That
  // is a pre-existing modelling gap, to fix when corridors are modelled.
  baseFee            BigInt  @default(0)
  // RATES, not money — genuinely fractional, so these stay Decimal.
  // Percentage fee on the send amount, e.g. 1.5 means 1.5%
  percentFee         Decimal @default(0)
  // Margin the provider takes off the mid-market rate, e.g. 2.0 means 2%
  exchangeRateMargin Decimal @default(0)
  transferSpeedHours Int     @default(24)
  // Comma-separated ISO codes of supported source currencies, e.g. "USD,RUB,KZT"
  sourceCurrencies   String

  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  householdId String
  // "REMITTANCE" (money sent home) | "EXPENSE" | "INCOME" | "SAVINGS"
  type        String
  // Nullable: only remittances have sender/receiver/provider
  senderId    String?
  receiverId  String?
  providerId  String?
  // Nullable: set on SAVINGS rows that contribute to a specific goal, so the
  // goal-detail view can show real contributors and contribution history.
  goalId      String?
  // MINOR units of `currency` (always UZS on every current write path).
  amount      BigInt
  currency    String   @default("UZS")
  // For remittances: the original send-side amount, in MINOR units of
  // `sourceCurrency` — a DIFFERENT currency from `amount` above, so the two
  // columns are scaled independently.
  sourceAmount   BigInt?
  sourceCurrency String?
  // Budget category slug for EXPENSE rows (see src/lib/categories.ts)
  category    String?
  note        String?
  date        DateTime
  // Current state. See src/lib/transaction-state.ts for the machine:
  // "PENDING" | "COMPLETED" | "FAILED" | "DISPUTED" | "REVERSED".
  // Only COMPLETED counts toward balances and the Trust Score, so a reversed
  // row drops out of every total without the row being destroyed.
  status      String   @default("COMPLETED")
  // Caller-supplied key that makes creation idempotent: a retry or double
  // click replays the same key and returns the original record instead of
  // creating a second one (and, for a remittance, a second card debit).
  // Nullable because historic and seeded rows have none — Postgres allows
  // many NULLs under a unique index.
  idempotencyKey String? @unique
  // True for rows created by the seed script (demo history is labeled in the UI)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  household Household           @relation(fields: [householdId], references: [id])
  sender    User?               @relation("SentTransactions", fields: [senderId], references: [id])
  receiver  User?               @relation("ReceivedTransactions", fields: [receiverId], references: [id])
  provider  RemittanceProvider? @relation(fields: [providerId], references: [id])
  goal      SavingsGoal?        @relation(fields: [goalId], references: [id])
  events    TransactionEvent[]

  @@index([householdId, date])
  @@index([householdId, type])
  @@index([goalId])
  // Admin queues filter by state, so it needs to be indexed.
  @@index([householdId, status])
}

/// Append-only transition log: one row per state change, including creation.
/// This is the who / what / when / why behind every transaction — the record
/// that makes history tamper-evident. Rows are never updated or deleted.
model TransactionEvent {
  id            String   @id @default(cuid())
  transactionId String
  /// Null on the creation row — there is no prior state.
  fromStatus    String?
  toStatus      String
  /// "CREATE" plus the TransactionEventName values in transaction-state.ts.
  event         String
  /// The operator who acted. Null for system/seed-created rows.
  actorId       String?
  /// Required justification — see src/lib/reason-codes.ts.
  reasonCode    String
  /// Optional operator free text on top of the code.
  note          String?
  metadata      Json?
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  actor       User?       @relation("TransactionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([transactionId, createdAt])
  @@index([actorId, createdAt])
}

model Budget {
  id              String  @id @default(cuid())
  householdId     String
  category        String
  // MINOR units of `currency`.
  amountAllocated BigInt
  currency        String  @default("UZS")
  // Month the allocation applies to, formatted "YYYY-MM"
  period          String

  household Household @relation(fields: [householdId], references: [id])

  @@unique([householdId, category, period])
}

model SavingsGoal {
  id            String    @id @default(cuid())
  householdId   String
  name          String
  // MINOR units of `currency`.
  targetAmount  BigInt
  currentAmount BigInt    @default(0)
  currency      String    @default("UZS")
  targetDate    DateTime?
  createdAt     DateTime  @default(now())

  household     Household     @relation(fields: [householdId], references: [id])
  contributions Transaction[]
}

/// An operator adjustment layered ON TOP of the computed Trust Score.
///
/// The score is disputable, so it must be correctable — but a corrected score
/// that is indistinguishable from a computed one is not auditable. So nothing
/// here mutates `TrustScoreSnapshot` or the computation: the base score is
/// recomputed from the ledger as always, and `delta` is applied on read. Both
/// numbers stay visible, which is what lets a customer be told "your score is
/// 68: 61 computed, +7 for the dispute we resolved in your favour".
///
/// Rows are never deleted. An override is retired by setting `revokedAt`, so
/// the history of every adjustment survives.
model TrustScoreOverride {
  id          String    @id @default(cuid())
  householdId String
  /// Signed points added to the computed score. The sum is clamped to 0-100
  /// on read, never here — see src/lib/trust-override.ts.
  delta       Int
  /// Filterable justification, from OVERRIDE_REASON_CODES.
  reasonCode  String
  /// The specifics. Mandatory: this is what a disputing customer is owed.
  reason      String
  actorId     String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  revokedById String?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     User      @relation("TrustOverrideActor", fields: [actorId], references: [id])
  revokedBy User?     @relation("TrustOverrideRevoker", fields: [revokedById], references: [id])

  @@index([householdId, createdAt])
}

model TrustScoreSnapshot {
  id                String   @id @default(cuid())
  householdId       String
  score             Int
  consistencyFactor Int
  stabilityFactor   Int
  savingsFactor     Int
  calculatedAt      DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id])

  @@index([householdId, calculatedAt])
}
