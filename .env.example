# Copy to .env and fill in. Never commit real secrets.

# SQLite for local development:
DATABASE_URL="file:./dev.db"
# Hosted Postgres (Neon/Supabase) for production — also switch the
# datasource provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Absolute URL of the deployment (http://localhost:3000 for local dev)
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional — powers the in-app AI assistant (Yordam) with Claude.
# Without a key the assistant runs in built-in guide mode.
# Get a key at https://platform.claude.com
# ANTHROPIC_API_KEY=""
# ASSISTANT_MODEL="claude-opus-4-8"

# Optional — live FX rates for the rate finder (exchangerate-api.com).
# Leave unset to use the provider's free keyless endpoint (open.er-api.com);
# set a key to use the authenticated v6 endpoint. Falls back to the static
# sample table when the feed is unreachable.
# EXCHANGERATE_API_KEY=""

# Supabase — auth (email/password) + wallet/transaction system.
# Find these in your Supabase project: Settings > API. The publishable
# (anon) key is safe to expose to the browser. REQUIRED on Vercel for
# production auth to work.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Telegram "logs bot" — forwards sign-ups, logins, investor inquiries, admin
# actions and (optionally) page visits to ONE private group, "Sendyurt logs".
# Leave both unset to disable entirely (the app no-ops — no logs are sent).
#   1. Create the bot with @BotFather, copy the token below.
#   2. Create the "Sendyurt logs" group and add the bot to it.
#   3. Get the group's chat id (it is negative, e.g. -1001234567890) — see
#      the getUpdates step in the setup docs — and set it below.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_LOG_CHAT_ID=""
# Optional — set to "false" to mute the noisy per-page-visit stream while
# keeping sign-ups/logins/investor/admin logs. Any other value = visits on.
# TELEGRAM_LOG_VISITS="true"

# Service-role (secret) key — server-only. Powers the admin activity dashboard
# (bypasses RLS). NEVER expose to the browser. Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe — direct/destination charges, platform commissions, Connect payouts.
# Test-mode keys from Dashboard → Developers → API keys. The publishable key is
# safe to expose to the browser; the secret key is server-only, never commit it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret from `stripe listen` or Dashboard → Webhooks:
STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform commission in basis points (250 = 2.5%):
STRIPE_PLATFORM_FEE_BPS="250"
