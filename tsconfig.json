{
  "compilerOptions": {
    // ES2020 for native BigInt: money is stored as Prisma `BigInt` (Postgres
    // BIGINT) and BigInt literals/iteration need this target. Next.js compiles
    // output with SWC against browserslist, so this affects type-checking
    // only — no change to what ships to browsers.
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-prod/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
